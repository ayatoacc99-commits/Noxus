# Noxus Panel Environment Configuration
# Copy to backend/.env and frontend/.env.local

# =====================
# Panel API
# =====================
NODE_ENV=production
PORT=3001
HOST=127.0.0.1
FRONTEND_URL=https://panel.yourdomain.com

# Generate with: openssl rand -hex 64
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=8h
JWT_COOKIE_NAME=noxus_token
JWT_REFRESH_COOKIE_NAME=noxus_refresh
CSRF_COOKIE_NAME=noxus_csrf

# =====================
# Panel Database (MariaDB/MySQL)
# =====================
PANEL_DB_HOST=127.0.0.1
PANEL_DB_PORT=3306
PANEL_DB_USER=noxus
PANEL_DB_PASSWORD=your_panel_db_password
PANEL_DB_NAME=noxus_panel

# =====================
# FiveM QB-Core Database
# =====================
FIVEM_DB_HOST=127.0.0.1
FIVEM_DB_PORT=3306
FIVEM_DB_USER=qbcore
FIVEM_DB_PASSWORD=your_qbcore_db_password
FIVEM_DB_NAME=qbcore

# =====================
# FiveM Server Paths (Ubuntu VPS)
# =====================
FIVEM_PROCESS_MODE=systemd
# Options: systemd | pm2 | direct
FIVEM_SYSTEMD_SERVICE=fivem
FIVEM_PM2_NAME=fivem

FIVEM_ARTIFACT_PATH=/opt/fivem/artifacts
FIVEM_SERVER_DATA_PATH=/opt/fivem/server-data
FIVEM_SERVER_CFG_PATH=/opt/fivem/server-data/server.cfg
FIVEM_RESOURCES_PATH=/opt/fivem/server-data/resources
FIVEM_BACKUP_FOLDER=/opt/fivem/backups
FIVEM_LOG_FILE=/opt/fivem/server-data/console.log

FIVEM_SERVER_IP=your.server.ip
FIVEM_SERVER_PORT=30120

# RCON (set rcon_password in server.cfg)
FIVEM_RCON_HOST=127.0.0.1
FIVEM_RCON_PORT=30120
FIVEM_RCON_PASSWORD=your_rcon_password

# =====================
# Backups
# =====================
BACKUP_RETENTION_COUNT=7
BACKUP_SCHEDULE_ENABLED=true

# =====================
# Security
# =====================
BCRYPT_ROUNDS=12
LOGIN_RATE_LIMIT_WINDOW_MS=900000
LOGIN_RATE_LIMIT_MAX=10
TRUST_PROXY=true

# Optional IP allowlist (comma-separated)
# IP_ALLOWLIST=203.0.113.10,198.51.100.0/24

# Discord OAuth
DISCORD_OAUTH_ENABLED=false
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=http://127.0.0.1:3001/api/auth/discord/callback
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
DISCORD_ROLE_OWNER=OWNER_ROLE_ID
DISCORD_ROLE_DEVELOPER=DEV_ROLE_ID
DISCORD_ROLE_ADMIN=ADMIN_ROLE_ID
DISCORD_ROLE_MODERATOR=MOD_ROLE_ID

# SEED_OWNER_USERNAME=owner
# SEED_OWNER_PASSWORD=change-me
# SEED_OWNER_EMAIL=owner@example.com

# =====================
# Frontend (.env.local)
# =====================
# NEXT_PUBLIC_API_URL=https://panel.yourdomain.com/api
# NEXT_PUBLIC_WS_URL=https://panel.yourdomain.com
